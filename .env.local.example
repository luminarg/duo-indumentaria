# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # NUNCA exponer al navegador, solo server-side

# Sitio público (para armar los links de pedido)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — mails transaccionales (resend.com)
RESEND_API_KEY=re_...

# Web Push — notificaciones (generar con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tuemail@duoindumentaria.com
